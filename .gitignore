```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
env/

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Environment files
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/

# Build/dist directories
dist/
build/
target/

# Coverage reports
.coverage
coverage/
htmlcov/

# Python cache
.mypy_cache/
.pytest_cache/
```